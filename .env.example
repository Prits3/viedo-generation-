# ── Signup waitlist database (Supabase Postgres) ──
# Supabase → Project → Settings → Database → "Connection string" → Transaction pooler.
# Use the POOLER string (host ...pooler.supabase.com, port 6543) for Vercel/serverless.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# ── Optional: live lesson generation (existing /upload flow, not needed for the demo) ──
# ANTHROPIC_API_KEY=
